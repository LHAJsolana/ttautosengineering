# Use either Resend email delivery or a webhook for lead submissions.
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@ttautosengineering.com
LEAD_FROM_EMAIL=TT AUTO'S Leads <leads@ttautosengineering.com>

# Optional alternative to Resend (CRM, automation platform, or private endpoint).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional durable JSONL fallback outside the public web root.
LEAD_STORAGE_PATH=

# Optional bot protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# carVertical affiliate integration.
NEXT_PUBLIC_CARVERTICAL_VIN_URL=
NEXT_PUBLIC_CARVERTICAL_GENERAL_URL=

# TT AUTO'S AI Garage. Keep OPENAI_API_KEY server-side only.
AI_GARAGE_ENABLED=true
AI_GARAGE_PUBLIC_ENABLED=false
AI_GARAGE_PREVIEW_TOKEN=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_REQUESTS_PER_WINDOW=30
AI_RATE_LIMIT_WINDOW_MS=900000
MCV_MAX_ATTEMPTS=2
